{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "badwebsitedesignsmuseum",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-03",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  }
}
